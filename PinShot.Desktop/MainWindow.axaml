<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PinShot.Desktop.MainWindow"
        Title="PinShot"
        Width="480" Height="780"
        MinWidth="360" MinHeight="480"
        Background="#0B1120"
        Foreground="#E2E8F0"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Border Grid.Row="0" Background="#111B2B" Padding="16,12">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
        <Image Source="avares://PinShot/Assets/PinShot_logo.png"
               Width="38" Height="38" Stretch="Uniform"/>
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="PINSHOT" FontSize="13" FontWeight="Bold"/>
          <TextBlock Text="CAPTURAS Y NOTAS" Foreground="#60A5FA" FontSize="9"
                     FontWeight="SemiBold" Margin="0,2,0,0"/>
        </StackPanel>
        <Button Grid.Column="2" Classes="icon" Content="⚙" ToolTip.Tip="Configuración"
                Click="Settings_Click"/>
        <Button Grid.Column="3" Classes="icon" Content="＋" ToolTip.Tip="Nueva nota"
                Click="NewNote_Click"/>
      </Grid>
    </Border>

    <StackPanel Grid.Row="1" Margin="16,16,16,12" Spacing="8">
      <TextBlock Text="Tus notas" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock Text="Capturas, ideas y referencias en un solo lugar"
                 Foreground="#91A0B4" FontSize="12"/>
      <TextBox x:Name="SearchBox" Classes="search" PlaceholderText="Buscar por texto o etiqueta"
               TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>
      <CheckBox x:Name="PinnedOnlyCheck" Content="Solo notas fijadas"
                Foreground="#AAB8CA" IsCheckedChanged="PinnedOnly_Changed"/>
    </StackPanel>

    <ScrollViewer Grid.Row="2" Margin="12,0,8,12" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="CardsPanel" Spacing="10" Margin="0,0,6,0"/>
    </ScrollViewer>

    <Border Grid.Row="3" Background="#111B2B" Padding="14,10">
      <TextBlock x:Name="StatusText"
                 Text="Copia una captura al portapapeles para abrirla en PinShot."
                 Foreground="#91A0B4" FontSize="11" TextWrapping="Wrap"/>
    </Border>
  </Grid>

  <Window.Styles>
    <Style Selector="Button.icon">
      <Setter Property="Width" Value="38"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#CBD5E1"/>
      <Setter Property="FontSize" Value="19"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.icon:pointerover">
      <Setter Property="Background" Value="#263B82F6"/>
      <Setter Property="Foreground" Value="#60A5FA"/>
    </Style>
    <Style Selector="TextBox.search">
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Background" Value="#131E2E"/>
      <Setter Property="Foreground" Value="#F8FAFC"/>
      <Setter Property="BorderBrush" Value="#2A3A50"/>
      <Setter Property="Padding" Value="12,8"/>
    </Style>
  </Window.Styles>
</Window>
