<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PinShot.Desktop.NoteEditorWindow"
        Title="Nota - PinShot"
        Width="620" Height="700"
        MinWidth="380" MinHeight="460"
        Background="#0B1120"
        Foreground="#E2E8F0"
        WindowStartupLocation="CenterOwner"
        KeyDown="Window_KeyDown">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Background="#111B2B" Padding="14">
      <Grid ColumnDefinitions="6,*,Auto,Auto,Auto">
        <Border x:Name="HeaderAccent" Grid.Column="0" CornerRadius="3"/>
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="EDITAR NOTA" FontWeight="SemiBold"/>
          <TextBlock x:Name="DateText" Foreground="#91A0B4" FontSize="10"/>
        </StackPanel>
        <Button Grid.Column="2" x:Name="PinButton" Content="Fijar"
                Click="Pin_Click" Margin="4,0"/>
        <Button Grid.Column="3" Content="Eliminar" Click="Delete_Click" Margin="4,0"/>
        <Button Grid.Column="4" Content="Cerrar" Click="Close_Click" Margin="4,0"/>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="16" Spacing="12">
        <TextBox x:Name="NoteText" AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="160" PlaceholderText="Escribe una nota…"
                 TextChanged="NoteText_TextChanged"/>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox x:Name="TagInput" Width="220" PlaceholderText="Añadir etiqueta"
                   KeyDown="TagInput_KeyDown"/>
          <Button Content="Añadir etiqueta" Click="AddTag_Click"/>
        </StackPanel>
        <WrapPanel x:Name="TagsPanel"/>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Imágenes" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button Content="Pegar" Click="PasteImage_Click"/>
          <Button Content="Añadir…" Click="AddImage_Click"/>
        </StackPanel>
        <WrapPanel x:Name="ImagesPanel"/>

        <StackPanel>
          <TextBlock Text="Color de la nota" Foreground="#91A0B4" FontSize="11"
                     Margin="0,4,0,6"/>
          <WrapPanel x:Name="PalettePanel"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="#111B2B" Padding="14,9">
      <TextBlock x:Name="SaveStatus" Text="Nueva nota" Foreground="#91A0B4"
                 FontSize="11"/>
    </Border>
  </Grid>
</Window>
