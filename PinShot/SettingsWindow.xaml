<Window x:Class="PinShot.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración - PinShot"
        Width="400" Height="500"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#0B1120"
        Topmost="True"
        WindowStartupLocation="CenterScreen">

    <Border BorderBrush="#263449" BorderThickness="1" CornerRadius="9">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#111B2B" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Image Source="pack://application:,,,/PinShot_logo.png"
                       Width="34" Height="34"
                       HorizontalAlignment="Left"
                       Margin="12,12,0,12"/>
                <StackPanel VerticalAlignment="Center" Margin="54,0,0,0">
                    <TextBlock Text="PINSHOT" Foreground="#F8FAFC" FontSize="12" FontWeight="Bold"/>
                    <TextBlock Text="CONFIGURACIÓN" Foreground="#60A5FA" FontSize="9" FontWeight="SemiBold"
                               Margin="0,2,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource FlatBtn}"
                        HorizontalAlignment="Right"
                        Content="&#xE711;"
                        Click="Close_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,16,16,18">
                    <Border Background="#111B2B" BorderBrush="#263449" BorderThickness="1"
                            CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="APARIENCIA" Foreground="#60A5FA" FontSize="10"
                                       FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="Color predeterminado de las notas"
                                       Foreground="#E2E8F0" FontSize="13"/>
                            <StackPanel x:Name="PalettePanel" Orientation="Horizontal" Margin="0,10,0,4"/>
                            <Button Style="{StaticResource ActionBtn}"
                                    Content="Aplicar a todas las notas"
                                    Click="ApplyAll_Click"/>
                            <Border Height="1" Background="#263449" Margin="0,12,0,10"/>
                            <CheckBox x:Name="ColorBlindModeCheck"
                                      Foreground="#E2E8F0"
                                      FontSize="13"
                                      Content="Modo daltónico"
                                      Checked="ColorBlindMode_Changed"
                                      Unchecked="ColorBlindMode_Changed"/>
                            <TextBlock Text="Paleta accesible de alto contraste. Los colores no son la única señal."
                                       Foreground="#91A0B4" FontSize="11" TextWrapping="Wrap" Margin="22,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#111B2B" BorderBrush="#263449" BorderThickness="1"
                            CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ALMACENAMIENTO" Foreground="#60A5FA" FontSize="10"
                                       FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="Carpeta de notas" Foreground="#E2E8F0" FontSize="13"/>
                            <TextBlock x:Name="PathText" Foreground="#91A0B4" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,6,0,2"/>
                            <Button Style="{StaticResource ActionBtn}"
                                    Content="Abrir carpeta"
                                    Click="OpenFolder_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#111B2B" BorderBrush="#263449" BorderThickness="1"
                            CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="RESPALDO" Foreground="#60A5FA" FontSize="10"
                                       FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="Protege o mueve tus notas" Foreground="#E2E8F0"
                                       FontSize="13" Margin="0,0,0,4"/>
                            <Button Style="{StaticResource ActionBtn}"
                                    Content="Exportar respaldo..."
                                    Click="Export_Click"/>
                            <Button Style="{StaticResource ActionBtn}"
                                    Content="Importar respaldo..."
                                    Click="Import_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
