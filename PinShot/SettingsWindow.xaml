<Window x:Class="PinShot.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración - PinShot"
        Width="360" Height="410"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#202020"
        Topmost="True"
        WindowStartupLocation="CenterScreen">

    <Border BorderBrush="#454545" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#1A1A1A" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Image Source="pack://application:,,,/PinShot_logo.png"
                       Width="28" Height="28"
                       HorizontalAlignment="Left"
                       Margin="6,6,0,6"/>
                <TextBlock Text="Configuración"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="42,0,0,0"/>
                <Button Style="{StaticResource FlatBtn}"
                        HorizontalAlignment="Right"
                        Content="✕"
                        Click="Close_Click"/>
            </Grid>

            <StackPanel Grid.Row="1" Margin="18,16,18,12">
                <TextBlock Text="Color de las notas nuevas" Foreground="White" FontSize="14"/>
                <StackPanel x:Name="PalettePanel" Orientation="Horizontal" Margin="0,12,0,4"/>
                <Button Style="{StaticResource ActionBtn}"
                        Content="Aplicar este color a todas las notas"
                        Click="ApplyAll_Click"/>

                <TextBlock Text="Carpeta de notas" Foreground="White" FontSize="14" Margin="0,22,0,0"/>
                <TextBlock x:Name="PathText"
                           Foreground="#8A8A8A"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
                <Button Style="{StaticResource ActionBtn}"
                        Content="Abrir carpeta"
                        Click="OpenFolder_Click"/>
                <TextBlock Text="Respaldo de notas" Foreground="White" FontSize="14" Margin="0,18,0,0"/>
                <Button Style="{StaticResource ActionBtn}"
                        Content="Exportar respaldo..."
                        Click="Export_Click"/>
                <Button Style="{StaticResource ActionBtn}"
                        Content="Importar respaldo..."
                        Click="Import_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
