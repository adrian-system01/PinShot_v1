<Window x:Class="PinShot.NoteEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nota - PinShot"
        Width="360" Height="520"
        MinWidth="280" MinHeight="260"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#262626"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border x:Name="FrameBorder" BorderThickness="1" BorderBrush="#3F3F3F">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabecera con el color de la nota -->
            <Border x:Name="HeaderBar" Grid.Row="0" Background="#22C55E"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Image Source="pack://application:,,,/PinShot_logo.png"
                               Width="28" Height="28"
                               Margin="4,4,2,4"/>
                        <Button Style="{StaticResource FlatBtn}" Width="36" Height="36"
                                Content="📋" ToolTip="Pegar imagen (Ctrl+V)"
                                Click="PasteImage_Click"/>
                        <Button Style="{StaticResource FlatBtn}" Width="36" Height="36"
                                Content="🖼" ToolTip="Añadir imagen desde archivo"
                                Click="AddImage_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource FlatBtn}" Width="36" Height="36"
                                Content="🗑" ToolTip="Eliminar nota"
                                Click="Delete_Click"/>
                        <Button Style="{StaticResource FlatBtn}" Width="36" Height="36"
                                Content="✕" ToolTip="Cerrar (Esc)"
                                Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Imagenes de la nota -->
            <ScrollViewer x:Name="ImagesScroll" Grid.Row="1"
                          Visibility="Collapsed"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          Margin="10,10,10,0">
                <StackPanel x:Name="ImagesPanel" Orientation="Horizontal"/>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="10,6,10,2">
                <WrapPanel x:Name="TagsPanel"/>
                <DockPanel Margin="0,4,0,0">
                    <Button Style="{StaticResource ActionBtn}"
                            Content="Añadir etiqueta"
                            Margin="6,0,0,0"
                            Click="AddTag_Click"/>
                    <TextBox x:Name="TagInput"
                             Height="30"
                             Background="#2D2D2D"
                             Foreground="White"
                             CaretBrush="White"
                             BorderThickness="0"
                             Padding="8,0"
                             VerticalContentAlignment="Center"
                             ToolTip="Escribe una etiqueta y pulsa Enter"
                             KeyDown="TagInput_KeyDown"/>
                </DockPanel>
            </StackPanel>

            <!-- Texto -->
            <Grid Grid.Row="3">
                <TextBox x:Name="NoteText"
                         Background="Transparent"
                         Foreground="White"
                         CaretBrush="White"
                         SelectionBrush="#FF3B82F6"
                         BorderThickness="0"
                         Padding="12"
                         FontSize="15"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         TextChanged="NoteText_TextChanged"/>
                <TextBlock x:Name="Hint"
                           Text="Toma una nota..."
                           Foreground="#808080"
                           FontSize="15"
                           Margin="17,12,0,0"
                           IsHitTestVisible="False"/>
            </Grid>

            <!-- Pie: colores + fecha -->
            <Border Grid.Row="4" Background="#1F1F1F" Padding="10,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="PalettePanel"
                                Grid.Row="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"/>
                    <TextBlock x:Name="SaveStatus"
                               Grid.Row="1"
                               Foreground="#8A8A8A"
                               FontSize="10"
                               VerticalAlignment="Center"
                               Margin="0,5,0,0"/>
                    <TextBlock x:Name="DateText"
                               Grid.Row="1"
                               Foreground="#8A8A8A"
                               FontSize="10"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,5,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
