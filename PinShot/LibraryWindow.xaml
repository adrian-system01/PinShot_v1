<Window x:Class="PinShot.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Biblioteca - PinShot"
        Width="400" Height="720"
        MinWidth="340" MinHeight="360"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#0B1120"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border BorderBrush="#263449" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Cabecera de marca -->
            <Grid Grid.Row="0" Background="#111B2B" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Image Source="pack://application:,,,/PinShot_logo.png"
                       Width="34" Height="34"
                       HorizontalAlignment="Left"
                       Margin="12,12,0,12"/>
                <StackPanel VerticalAlignment="Center" Margin="54,0,0,0">
                    <TextBlock Text="PINSHOT" Foreground="#F8FAFC" FontSize="13" FontWeight="Bold"/>
                    <TextBlock Text="BIBLIOTECA" Foreground="#60A5FA" FontSize="9" FontWeight="SemiBold"
                               Margin="0,2,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource FlatBtn}"
                        Width="36" Height="36"
                        HorizontalAlignment="Right"
                        Margin="0,0,92,0"
                        Content="&#xE710;"
                        ToolTip="Nueva nota"
                        Click="NewNote_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource FlatBtn}"
                            Content="&#xE713;"
                            ToolTip="Configuración"
                            Click="Settings_Click"/>
                    <Button Style="{StaticResource FlatBtn}"
                            Content="&#xE711;"
                            ToolTip="Cerrar"
                            Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- Titulo + buscador -->
            <StackPanel Grid.Row="1" Margin="14,14,14,12">
                <TextBlock Text="Tus notas"
                           Foreground="#F8FAFC"
                           FontSize="21"
                           FontWeight="SemiBold"
                           Margin="0,0,0,3"/>
                <TextBlock Text="Capturas, ideas y referencias en un solo lugar"
                           Foreground="#8190A5"
                           FontSize="11"
                           Margin="0,0,0,12"/>
                <Grid>
                    <TextBox x:Name="SearchBox"
                             Height="38"
                             Background="#131E2E"
                             Foreground="White"
                             CaretBrush="White"
                             BorderBrush="#2A3A50"
                             BorderThickness="1"
                             Padding="12,0,36,0"
                             VerticalContentAlignment="Center"
                             FontSize="13"
                             TextChanged="SearchBox_TextChanged"/>
                    <TextBlock x:Name="SearchHint"
                               Text="Buscar por texto o etiqueta"
                               Foreground="#748399"
                               FontSize="13"
                               Margin="13,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                    <TextBlock Text="&#xE721;"
                               FontFamily="Segoe MDL2 Assets"
                               Foreground="#60A5FA"
                               FontSize="15"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               IsHitTestVisible="False"/>
                </Grid>
                <CheckBox x:Name="PinnedOnlyCheck"
                          Content="Solo notas fijadas"
                          Foreground="#AAB8CA"
                          Margin="2,10,0,0"
                          Checked="PinnedOnly_Changed"
                          Unchecked="PinnedOnly_Changed"/>
            </StackPanel>

            <!-- Lista de notas -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="12,0,6,10">
                <StackPanel x:Name="CardsPanel" Margin="0,0,6,0"/>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
