<Window x:Class="PinShot.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notas rápidas - PinShot"
        Width="380" Height="720"
        MinWidth="320" MinHeight="320"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#202020"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border BorderBrush="#454545" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Cabecera -->
            <Grid Grid.Row="0" Background="#1A1A1A" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Image Source="pack://application:,,,/PinShot_logo.png"
                       Width="28" Height="28"
                       HorizontalAlignment="Left"
                       Margin="6,6,0,6"/>
                <Button Style="{StaticResource FlatBtn}"
                        HorizontalAlignment="Left"
                        Margin="34,0,0,0"
                        FontSize="22"
                        Content="+"
                        ToolTip="Nueva nota"
                        Click="NewNote_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource FlatBtn}"
                            Content="⚙"
                            ToolTip="Configuración"
                            Click="Settings_Click"/>
                    <Button Style="{StaticResource FlatBtn}"
                            Content="✕"
                            ToolTip="Cerrar"
                            Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- Titulo + buscador -->
            <StackPanel Grid.Row="1" Margin="12,8,12,10">
                <TextBlock Text="Notas rápidas"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>
                <Grid>
                    <TextBox x:Name="SearchBox"
                             Height="34"
                             Background="#2D2D2D"
                             Foreground="White"
                             CaretBrush="White"
                             BorderThickness="0"
                             Padding="10,0,32,0"
                             VerticalContentAlignment="Center"
                             FontSize="13"
                             TextChanged="SearchBox_TextChanged"/>
                    <TextBlock x:Name="SearchHint"
                               Text="Buscar..."
                               Foreground="#8A8A8A"
                               FontSize="13"
                               Margin="11,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                    <TextBlock Text="🔍"
                               Foreground="#9A9A9A"
                               FontSize="13"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               IsHitTestVisible="False"/>
                </Grid>
                <CheckBox x:Name="PinnedOnlyCheck"
                          Content="Mostrar solo fijadas"
                          Foreground="#C0C0C0"
                          Margin="0,8,0,0"
                          Checked="PinnedOnly_Changed"
                          Unchecked="PinnedOnly_Changed"/>
            </StackPanel>

            <!-- Lista de notas -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="12,0,6,10">
                <StackPanel x:Name="CardsPanel" Margin="0,0,6,0"/>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
