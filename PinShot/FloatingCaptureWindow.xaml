<Window x:Class="PinShot.FloatingCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PinShot"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        SizeToContent="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="True"
        MinWidth="200"
        MinHeight="150"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseMove="Window_MouseMove"
        MouseWheel="Window_MouseWheel"
        MouseDoubleClick="Window_MouseDoubleClick"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        KeyDown="Window_KeyDown">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Guardar en notas" InputGestureText="Ctrl+S" Click="MenuSaveNote_Click"/>
            <MenuItem Header="Guardar como archivo..." InputGestureText="Ctrl+Mayús+S" Click="MenuSaveFile_Click"/>
            <MenuItem Header="Copiar imagen" InputGestureText="Ctrl+C" Click="MenuCopy_Click"/>
            <Separator/>
            <MenuItem Header="Abrir lista de notas" InputGestureText="Ctrl+L" Click="MenuLibrary_Click"/>
            <Separator/>
            <MenuItem Header="Cerrar" InputGestureText="Esc" Click="MenuClose_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Window.Resources>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#CC374151"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI Emoji, Segoe UI Symbol, Segoe UI"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="8"
            BorderBrush="#FF3B82F6"
            BorderThickness="2"
            CornerRadius="6"
            Background="#1E1E1E">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.6" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Border x:Name="ImageHost" ClipToBounds="True" CornerRadius="4">
                <Image x:Name="CaptureImage"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="ImageTranslate" X="0" Y="0"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
            </Border>

            <!-- Panel de notas -->
            <Border x:Name="NotesPanel"
                    Visibility="Collapsed"
                    VerticalAlignment="Bottom"
                    Margin="6"
                    Padding="8,4,8,6"
                    CornerRadius="6"
                    Background="#E61F2937"
                    BorderBrush="#FF374151"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="📝 Notas  (Esc para salir del texto)"
                               Foreground="#9CA3AF"
                               FontSize="11"
                               Margin="0,0,0,2"/>
                    <TextBox x:Name="NotesBox"
                             MinHeight="44"
                             MaxHeight="120"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Background="Transparent"
                             Foreground="White"
                             CaretBrush="White"
                             SelectionBrush="#FF3B82F6"
                             BorderThickness="0"
                             FontSize="13"
                             TextChanged="NotesBox_TextChanged"/>
                </StackPanel>
            </Border>

            <!-- Indicador de zoom -->
            <Border x:Name="ZoomBadge"
                    Visibility="Collapsed"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="6"
                    Padding="8,2"
                    CornerRadius="6"
                    Background="#CC111827"
                    IsHitTestVisible="False">
                <TextBlock x:Name="ZoomText" Foreground="White" FontSize="12"/>
            </Border>

            <!-- Aviso temporal -->
            <Border x:Name="ToastPanel"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,44,0,0"
                    Padding="12,4"
                    CornerRadius="6"
                    Background="#E6111827"
                    IsHitTestVisible="False">
                <TextBlock x:Name="ToastText" Foreground="White" FontSize="12"/>
            </Border>

            <!-- Barra de botones (aparece al pasar el mouse) -->
            <StackPanel x:Name="Toolbar"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="6"
                        Opacity="0">

                <Button x:Name="NotesButton" Style="{StaticResource ToolBtn}"
                        Click="NotesButton_Click" ToolTip="Notas (N)" Content="📝"/>

                <Button x:Name="LibraryButton" Style="{StaticResource ToolBtn}"
                        Click="LibraryButton_Click" ToolTip="Lista de notas (Ctrl+L)" Content="📚"/>

                <Button Style="{StaticResource ToolBtn}"
                        Click="CopyButton_Click" ToolTip="Copiar imagen (Ctrl+C)" Content="📋"/>

                <Button Style="{StaticResource ToolBtn}"
                        Click="SaveNoteButton_Click" ToolTip="Guardar en notas (Ctrl+S)" Content="💾"/>

                <Button x:Name="PinButton" Style="{StaticResource ToolBtn}"
                        Click="PinButton_Click"
                        ToolTip="Fijado encima de todo (Clic para desfijar)"
                        Background="#E62563EB" Content="📌"/>

                <Button Style="{StaticResource ToolBtn}"
                        Click="CloseButton_Click" ToolTip="Cerrar (Esc)"
                        Margin="0"
                        Background="#CC1F2937" Foreground="#F87171"
                        FontSize="13" FontWeight="Bold" Content="✕"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
